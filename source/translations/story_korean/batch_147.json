  "entries": [
    {
      "id": "archive/053/script/0/literal/0",
      "ja": "まず、ソウルユニゾンするためには\nソウルにおうじた チップを1まい\nいけにえに しなければならない",
      "ko": "먼저、소울 유니즌을 하려면\n소울에 맞는 칩을 1장\n제물로 바쳐야 한다",
      "source_bindings": {
        "blue_moon": {
          "payload_sha256": "0b083e71d861e99937d7d8011e3fc5999e6ee1aaf11261e9688bd2c580c1b16a",
          "tpl_sha256": "2c6ce35d2e2af2b0bdf0054f6a48cb9c183abc7178fe30729b3601abe624b353"
        },
        "red_sun": {
          "payload_sha256": "0f73d1ad30a82ee32aab860c2187c5b09fff2498e5256777a458a6ba4e3e0e32",
          "tpl_sha256": "8a918f57cbda3ba488e95a0d1d524078a7051ed4966a039edfcf430a29d59a8f"
        }
      }
    },
    {
      "id": "archive/053/script/1/literal/0",
      "ja": "いけにえ?\nじゃぁ、すてちゃうってコト?",
      "ko": "제물?\n그럼、버린다는 거야?",
      "source_bindings": {
        "blue_moon": {
          "payload_sha256": "0b083e71d861e99937d7d8011e3fc5999e6ee1aaf11261e9688bd2c580c1b16a",
          "tpl_sha256": "2c6ce35d2e2af2b0bdf0054f6a48cb9c183abc7178fe30729b3601abe624b353"
        },
        "red_sun": {
          "payload_sha256": "0f73d1ad30a82ee32aab860c2187c5b09fff2498e5256777a458a6ba4e3e0e32",
          "tpl_sha256": "8a918f57cbda3ba488e95a0d1d524078a7051ed4966a039edfcf430a29d59a8f"
        }
      }
    },
    {
      "id": "archive/053/script/10/literal/0",
      "ja": "ほら、こんなふうに\nゆうごうすることで、\nユニゾンチップが かんせいする",
      "ko": "봐라、이런 식으로\n융합함으로써、\n유니즌 칩이 완성된다",
      "source_bindings": {
        "blue_moon": {
          "payload_sha256": "0b083e71d861e99937d7d8011e3fc5999e6ee1aaf11261e9688bd2c580c1b16a",
          "tpl_sha256": "2c6ce35d2e2af2b0bdf0054f6a48cb9c183abc7178fe30729b3601abe624b353"
        },
        "red_sun": {
          "payload_sha256": "0f73d1ad30a82ee32aab860c2187c5b09fff2498e5256777a458a6ba4e3e0e32",
          "tpl_sha256": "8a918f57cbda3ba488e95a0d1d524078a7051ed4966a039edfcf430a29d59a8f"
        }
      }
    },
    {
      "id": "archive/053/script/10/literal/1",
      "ja": "これでOKを えらべば\nじどうてきに ソウルユニゾンが\nはつどうする!",
      "ko": "이걸로 OK를 고르면\n자동으로 소울 유니즌이\n발동한다!",
      "source_bindings": {
        "blue_moon": {
          "payload_sha256": "0b083e71d861e99937d7d8011e3fc5999e6ee1aaf11261e9688bd2c580c1b16a",
          "tpl_sha256": "2c6ce35d2e2af2b0bdf0054f6a48cb9c183abc7178fe30729b3601abe624b353"
        },
        "red_sun": {
          "payload_sha256": "0f73d1ad30a82ee32aab860c2187c5b09fff2498e5256777a458a6ba4e3e0e32",
          "tpl_sha256": "8a918f57cbda3ba488e95a0d1d524078a7051ed4966a039edfcf430a29d59a8f"
        }
      }
    },
    {
      "id": "archive/053/script/10/literal/2",
      "ja": "アクアソウルは水属性のチップを\nためうちしてつかうことで\n攻撃力が2ばいになる!",
      "ko": "아쿠아 소울은 물 속성 칩을\n모아치기로 쓰면\n공격력이 2배가 된다!",
      "source_bindings": {
        "blue_moon": {
          "payload_sha256": "0b083e71d861e99937d7d8011e3fc5999e6ee1aaf11261e9688bd2c580c1b16a",
          "tpl_sha256": "2c6ce35d2e2af2b0bdf0054f6a48cb9c183abc7178fe30729b3601abe624b353"
        },
        "red_sun": {
          "payload_sha256": "0f73d1ad30a82ee32aab860c2187c5b09fff2498e5256777a458a6ba4e3e0e32",
          "tpl_sha256": "8a918f57cbda3ba488e95a0d1d524078a7051ed4966a039edfcf430a29d59a8f"
        }
      },
      "ja_red_sun": "ガッツソウル中は\n無属性とちけいはかいけいの\nチップの攻撃力が+30されるぞ",
      "ko_red_sun": "거츠 소울 중에는\n무속성과 지형 파괴 계열\n칩의 공격력이 +30된다"
    },
    {
      "id": "archive/053/script/10/literal/3",
      "ja": "さらにBボタンのためうちが\nアクアショットになるぞ!",
      "ko": "게다가 B 버튼 모아치기가\n아쿠아 샷이 된다!",
      "source_bindings": {
        "blue_moon": {
          "payload_sha256": "0b083e71d861e99937d7d8011e3fc5999e6ee1aaf11261e9688bd2c580c1b16a",
          "tpl_sha256": "2c6ce35d2e2af2b0bdf0054f6a48cb9c183abc7178fe30729b3601abe624b353"
        },
        "red_sun": {
          "payload_sha256": "0f73d1ad30a82ee32aab860c2187c5b09fff2498e5256777a458a6ba4e3e0e32",
          "tpl_sha256": "8a918f57cbda3ba488e95a0d1d524078a7051ed4966a039edfcf430a29d59a8f"
        }
      },
      "ja_red_sun": "さらにBボタンのためうちが\nガッツパンチになるうえ",
      "ko_red_sun": "게다가 B 버튼 모아치기가\n거츠펀치가 되는 데다"
    },
    {
      "id": "archive/053/script/10/literal/4",
      "ja": "では じっさいにやってみろ\n熱斗!",
      "ko": "그럼 실제로 해 봐라\n넷토!",
      "source_bindings": {
        "blue_moon": {
          "payload_sha256": "0b083e71d861e99937d7d8011e3fc5999e6ee1aaf11261e9688bd2c580c1b16a",
          "tpl_sha256": "2c6ce35d2e2af2b0bdf0054f6a48cb9c183abc7178fe30729b3601abe624b353"
        },
        "red_sun": {
          "payload_sha256": "0f73d1ad30a82ee32aab860c2187c5b09fff2498e5256777a458a6ba4e3e0e32",
          "tpl_sha256": "8a918f57cbda3ba488e95a0d1d524078a7051ed4966a039edfcf430a29d59a8f"
        }
      },
      "ja_red_sun": "Bボタンれんだで\nむてきじょうたいで はなつ\nガッツマシンガンがだせる!",
      "ko_red_sun": "B 버튼 연타로\n무적 상태에서 쏘는\n거츠 머신건을 쓸 수 있다!"
    },
    {
      "id": "archive/053/script/10/literal/5",
      "ja": "じっさいに つかってみろ",
      "ko": "실제로 써 봐라",
      "source_bindings": {
        "red_sun": {
          "payload_sha256": "0f73d1ad30a82ee32aab860c2187c5b09fff2498e5256777a458a6ba4e3e0e32",
          "tpl_sha256": "8a918f57cbda3ba488e95a0d1d524078a7051ed4966a039edfcf430a29d59a8f"
        }
      }
    },
    {
      "id": "archive/053/script/11/literal/0",
      "ja": "これが ソウルユニゾンだ\nうまくつかえば かなりの\nせんりょくUPになる",
      "ko": "이것이 소울 유니즌이다\n잘 쓰면 상당한\n전력 UP이 된다",
      "source_bindings": {
        "blue_moon": {
          "payload_sha256": "0b083e71d861e99937d7d8011e3fc5999e6ee1aaf11261e9688bd2c580c1b16a",
          "tpl_sha256": "2c6ce35d2e2af2b0bdf0054f6a48cb9c183abc7178fe30729b3601abe624b353"
        },
        "red_sun": {
          "payload_sha256": "0f73d1ad30a82ee32aab860c2187c5b09fff2498e5256777a458a6ba4e3e0e32",
          "tpl_sha256": "8a918f57cbda3ba488e95a0d1d524078a7051ed4966a039edfcf430a29d59a8f"
        }
      }
    },
    {
      "id": "archive/053/script/11/literal/1",
      "ja": "ただし むせいげんにいくらでも\nユニゾンできるわけじゃない\nいくつか せいげんがあるんだ",
      "ko": "단 무제한으로 얼마든지\n유니즌할 수 있는 건 아니다\n몇 가지 제한이 있다",
      "source_bindings": {
        "blue_moon": {
          "payload_sha256": "0b083e71d861e99937d7d8011e3fc5999e6ee1aaf11261e9688bd2c580c1b16a",
          "tpl_sha256": "2c6ce35d2e2af2b0bdf0054f6a48cb9c183abc7178fe30729b3601abe624b353"
        },
        "red_sun": {
          "payload_sha256": "0f73d1ad30a82ee32aab860c2187c5b09fff2498e5256777a458a6ba4e3e0e32",
          "tpl_sha256": "8a918f57cbda3ba488e95a0d1d524078a7051ed4966a039edfcf430a29d59a8f"
        }
      }
    },
    {
      "id": "archive/053/script/11/literal/2",
      "ja": "まず ひとつめ\nレギュラーチップをいけにえに\nすることはできない",
      "ko": "우선 첫째\n레귤러 칩을 제물로\n바칠 수는 없다",
      "source_bindings": {
        "blue_moon": {
          "payload_sha256": "0b083e71d861e99937d7d8011e3fc5999e6ee1aaf11261e9688bd2c580c1b16a",
          "tpl_sha256": "2c6ce35d2e2af2b0bdf0054f6a48cb9c183abc7178fe30729b3601abe624b353"
        },
        "red_sun": {
          "payload_sha256": "0f73d1ad30a82ee32aab860c2187c5b09fff2498e5256777a458a6ba4e3e0e32",
          "tpl_sha256": "8a918f57cbda3ba488e95a0d1d524078a7051ed4966a039edfcf430a29d59a8f"
        }
      }
    },
    {
      "id": "archive/053/script/11/literal/3",
      "ja": "ふたつめ\nそのバトル中に おなじソウルには\nいちどしかユニゾンできない",
      "ko": "둘째\n그 배틀 중에 같은 소울로는\n한 번밖에 유니즌할 수 없다",
      "source_bindings": {
        "blue_moon": {
          "payload_sha256": "0b083e71d861e99937d7d8011e3fc5999e6ee1aaf11261e9688bd2c580c1b16a",
          "tpl_sha256": "2c6ce35d2e2af2b0bdf0054f6a48cb9c183abc7178fe30729b3601abe624b353"
        },
        "red_sun": {
          "payload_sha256": "0f73d1ad30a82ee32aab860c2187c5b09fff2498e5256777a458a6ba4e3e0e32",
          "tpl_sha256": "8a918f57cbda3ba488e95a0d1d524078a7051ed4966a039edfcf430a29d59a8f"
        }
      }
    },
    {
      "id": "archive/053/script/11/literal/4",
      "ja": "みっつめ\nソウルユニゾンしていられるのは\n3ターンのあいだ だけ",
      "ko": "셋째\n소울 유니즌은\n3턴 동안만 유지된다",
      "source_bindings": {
        "blue_moon": {
          "payload_sha256": "0b083e71d861e99937d7d8011e3fc5999e6ee1aaf11261e9688bd2c580c1b16a",
          "tpl_sha256": "2c6ce35d2e2af2b0bdf0054f6a48cb9c183abc7178fe30729b3601abe624b353"
        },
        "red_sun": {
          "payload_sha256": "0f73d1ad30a82ee32aab860c2187c5b09fff2498e5256777a458a6ba4e3e0e32",
          "tpl_sha256": "8a918f57cbda3ba488e95a0d1d524078a7051ed4966a039edfcf430a29d59a8f"
        }
      }
    },
    {
      "id": "archive/053/script/11/literal/5",
      "ja": "これらの せいげんをふまえた上で\nよくかんがえて つかいわけろ!",
      "ko": "이 제한들을 염두에 두고\n잘 생각해서 가려 써라!",
      "source_bindings": {
        "blue_moon": {
          "payload_sha256": "0b083e71d861e99937d7d8011e3fc5999e6ee1aaf11261e9688bd2c580c1b16a",
          "tpl_sha256": "2c6ce35d2e2af2b0bdf0054f6a48cb9c183abc7178fe30729b3601abe624b353"
        },
        "red_sun": {
          "payload_sha256": "0f73d1ad30a82ee32aab860c2187c5b09fff2498e5256777a458a6ba4e3e0e32",
          "tpl_sha256": "8a918f57cbda3ba488e95a0d1d524078a7051ed4966a039edfcf430a29d59a8f"
        }
      }
    },
    {
      "id": "archive/053/script/12/literal/0",
      "ja": "今は キャンセルしなくていいぞ",
      "ko": "지금은 취소하지 않아도 된다",
      "source_bindings": {
        "blue_moon": {
          "payload_sha256": "0b083e71d861e99937d7d8011e3fc5999e6ee1aaf11261e9688bd2c580c1b16a",
          "tpl_sha256": "2c6ce35d2e2af2b0bdf0054f6a48cb9c183abc7178fe30729b3601abe624b353"
        },
        "red_sun": {
          "payload_sha256": "0f73d1ad30a82ee32aab860c2187c5b09fff2498e5256777a458a6ba4e3e0e32",
          "tpl_sha256": "8a918f57cbda3ba488e95a0d1d524078a7051ed4966a039edfcf430a29d59a8f"
        }
      }
    },
    {
      "id": "archive/053/script/2/literal/0",
      "ja": "そうだ、今ロックマンが\nユニゾンできるソウルは\nアクアソウルだな",
      "ko": "그렇다、지금 록맨이\n유니즌할 수 있는 소울은\n아쿠아 소울이군",
      "source_bindings": {
        "blue_moon": {
          "payload_sha256": "0b083e71d861e99937d7d8011e3fc5999e6ee1aaf11261e9688bd2c580c1b16a",
          "tpl_sha256": "2c6ce35d2e2af2b0bdf0054f6a48cb9c183abc7178fe30729b3601abe624b353"
        },
        "red_sun": {
          "payload_sha256": "0f73d1ad30a82ee32aab860c2187c5b09fff2498e5256777a458a6ba4e3e0e32",
          "tpl_sha256": "8a918f57cbda3ba488e95a0d1d524078a7051ed4966a039edfcf430a29d59a8f"
        }
      },
      "ja_red_sun": "そうだ、今ロックマンが\nユニゾンできるソウルは\nガッツソウルだな",
      "ko_red_sun": "그렇다、지금 록맨이\n유니즌할 수 있는 소울은\n거츠 소울이군"
    },
    {
      "id": "archive/053/script/2/literal/1",
      "ja": "なら、水属性のチップを\nいけにえにすることによって\nソウルユニゾンすることができる",
      "ko": "그럼、물 속성 칩을\n제물로 바침으로써\n소울 유니즌을 할 수 있다",
      "source_bindings": {
        "blue_moon": {
          "payload_sha256": "0b083e71d861e99937d7d8011e3fc5999e6ee1aaf11261e9688bd2c580c1b16a",
          "tpl_sha256": "2c6ce35d2e2af2b0bdf0054f6a48cb9c183abc7178fe30729b3601abe624b353"
        },
        "red_sun": {
          "payload_sha256": "0f73d1ad30a82ee32aab860c2187c5b09fff2498e5256777a458a6ba4e3e0e32",
          "tpl_sha256": "8a918f57cbda3ba488e95a0d1d524078a7051ed4966a039edfcf430a29d59a8f"
        }
      },
      "ja_red_sun": "ガッツマンはそのコブシで\nパネルもろともはかいする\nパワフルなソウル・・・",
      "ko_red_sun": "거츠맨은 그 주먹으로\n패널째 파괴하는\n파워풀한 소울..."
    },
    {
      "id": "archive/053/script/2/literal/2",
      "ja": "やりかたは こうだ、\nまず、水属性のチップを\nえらんで・・・",
      "ko": "방법은 이렇다、\n먼저、물 속성 칩을\n골라서...",
      "source_bindings": {
        "blue_moon": {
          "payload_sha256": "0b083e71d861e99937d7d8011e3fc5999e6ee1aaf11261e9688bd2c580c1b16a",
          "tpl_sha256": "2c6ce35d2e2af2b0bdf0054f6a48cb9c183abc7178fe30729b3601abe624b353"
        },
        "red_sun": {
          "payload_sha256": "0f73d1ad30a82ee32aab860c2187c5b09fff2498e5256777a458a6ba4e3e0e32",
          "tpl_sha256": "8a918f57cbda3ba488e95a0d1d524078a7051ed4966a039edfcf430a29d59a8f"
        }
      },
      "ja_red_sun": "つまり「クラックアウト」などの\nちけいはかいチップを\nいけにえにすればユニゾンできる",
      "ko_red_sun": "즉 「크랙아웃」 같은\n지형 파괴 칩을\n제물로 바치면 유니즌된다"
    },
    {
      "id": "archive/053/script/2/literal/3",
      "ja": "やりかたは こうだ、\nまず、「クラックアウト」を\nえらんで・・・",
      "ko": "방법은 이렇다、\n먼저、「크랙아웃」을\n골라서...",
      "source_bindings": {
        "red_sun": {
          "payload_sha256": "0f73d1ad30a82ee32aab860c2187c5b09fff2498e5256777a458a6ba4e3e0e32",
          "tpl_sha256": "8a918f57cbda3ba488e95a0d1d524078a7051ed4966a039edfcf430a29d59a8f"
        }
      }
    },
    {
      "id": "archive/053/script/3/literal/0",
      "ja": "つぎにこれ、ユニゾンコマンドを\nえらぶんだ",
      "ko": "다음은 이것、유니즌 커맨드를\n고르는 거다",
      "source_bindings": {
        "blue_moon": {
          "payload_sha256": "0b083e71d861e99937d7d8011e3fc5999e6ee1aaf11261e9688bd2c580c1b16a",
          "tpl_sha256": "2c6ce35d2e2af2b0bdf0054f6a48cb9c183abc7178fe30729b3601abe624b353"
        },
        "red_sun": {
          "payload_sha256": "0f73d1ad30a82ee32aab860c2187c5b09fff2498e5256777a458a6ba4e3e0e32",
          "tpl_sha256": "8a918f57cbda3ba488e95a0d1d524078a7051ed4966a039edfcf430a29d59a8f"
        }
      }
    },
    {
      "id": "archive/053/script/4/literal/0",
      "ja": "やってみろ、熱斗",
      "ko": "해 봐라、넷토",
      "source_bindings": {
