      }
    },
    {
      "id": "archive/003/script/18/literal/0",
      "ja": "チップゲートがささってないぞ!",
      "ko": "칩 게이트가 꽂혀 있지 않다!",
      "source_bindings": {
        "blue_moon": {
          "payload_sha256": "0aa4b4dc77968daaa59f5330f531eaa3a60ab2b96947822e0008d28a1a57b620",
