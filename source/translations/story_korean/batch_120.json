          "payload_sha256": "11107cd70505c3d13c7b4354279a28ba982a83198536fbea6f1898ea1009a961",
          "tpl_sha256": "b08f173d0d5a30dbaf25f8c31a8173e45fe5e6d573f31a609ad8d06679036fd5"
        }
      }
    },
    {
      "id": "archive/086/script/6/literal/1",
      "ja": "」を\nパパにわたしに行くぞ!",
      "ko": "」\n아빠한테 건네주러 가자!",
      "source_bindings": {
        "blue_moon": {
          "payload_sha256": "11107cd70505c3d13c7b4354279a28ba982a83198536fbea6f1898ea1009a961",
          "tpl_sha256": "af971e10cedaa006d92286998836f31e546d314bc5b27a5622aaaac01bf692c1"
        },
        "red_sun": {
          "payload_sha256": "11107cd70505c3d13c7b4354279a28ba982a83198536fbea6f1898ea1009a961",
          "tpl_sha256": "b08f173d0d5a30dbaf25f8c31a8173e45fe5e6d573f31a609ad8d06679036fd5"
        }
      }
    },
    {
      "id": "archive/086/script/7/literal/0",
      "ja": "インターネットは\nかえってきてからにしよう\nさ、そとにでようぜ",
      "ko": "인터넷은\n돌아와서 하자\n자、밖으로 나가자",
      "source_bindings": {
        "blue_moon": {
          "payload_sha256": "11107cd70505c3d13c7b4354279a28ba982a83198536fbea6f1898ea1009a961",
          "tpl_sha256": "af971e10cedaa006d92286998836f31e546d314bc5b27a5622aaaac01bf692c1"
        },
        "red_sun": {
          "payload_sha256": "11107cd70505c3d13c7b4354279a28ba982a83198536fbea6f1898ea1009a961",
          "tpl_sha256": "b08f173d0d5a30dbaf25f8c31a8173e45fe5e6d573f31a609ad8d06679036fd5"
        }
      }
    },
    {
      "id": "archive/086/script/8/literal/0",
      "ja": "そろそろ まちあわせばしょに\n行ってみようぜ\nパパを またせちゃいけないし!",
      "ko": "슬슬 약속 장소에\n가 보자\n아빠를 기다리게 할 순 없지!",
      "source_bindings": {
        "blue_moon": {
          "payload_sha256": "11107cd70505c3d13c7b4354279a28ba982a83198536fbea6f1898ea1009a961",
          "tpl_sha256": "af971e10cedaa006d92286998836f31e546d314bc5b27a5622aaaac01bf692c1"
