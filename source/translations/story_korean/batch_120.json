          "tpl_sha256": "b08f173d0d5a30dbaf25f8c31a8173e45fe5e6d573f31a609ad8d06679036fd5"
        }
      }
    },
    {
      "id": "archive/086/script/5/literal/1",
      "ja": "」は\n秋原エリア3で\nうってるんだったな",
      "ko": "」\n아키하라 에리어3에서\n팔고 있었지",
      "source_bindings": {
